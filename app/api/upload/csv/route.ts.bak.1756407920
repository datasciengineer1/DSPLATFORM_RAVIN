export const runtime = "nodejs";
import { NextResponse } from "next/server";
import fs from "fs";
import path from "path";
import { parse } from "csv-parse/sync";

export async function POST(req: Request) {
  try {
    const form = await req.formData();
    const file = form.get("file") as File | null;
    if (!file) return NextResponse.json({ error: "No file" }, { status: 400 });

    const buf = Buffer.from(await file.arrayBuffer());
    const id = String(Date.now());

    // Save raw CSV for fallback loader
    const csvDir = path.join(process.cwd(), "data", "uploads");
    fs.mkdirSync(csvDir, { recursive: true });
    const csvPath = path.join(csvDir, `${id}.csv`);
    fs.writeFileSync(csvPath, buf);

    // Parse once and also save a JSON snapshot (so predict has a fast path)
    const rows = parse(buf.toString("utf8"), { columns: true, skip_empty_lines: true });

    const dsDir = path.join(process.cwd(), "data", "datasets");
    fs.mkdirSync(dsDir, { recursive: true });
    const jsonPath = path.join(dsDir, `${id}.json`);
    fs.writeFileSync(jsonPath, JSON.stringify(rows));

    return NextResponse.json({ id, name: file.name });
  } catch (e: any) {
    return NextResponse.json({ error: e?.message || "Upload failed" }, { status: 500 });
  }
}
