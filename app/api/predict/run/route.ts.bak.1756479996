import { NextResponse } from "next/server";
import { loadDatasetSync, listNumericColumns, detectDateColumn } from "../../../utils/datasets";

type PredictBody = { datasetId?: string; id?: string; question?: string; q?: string; target?: string; horizon?: number };

function parseBracket(text: string, key: string): string | null {
  try {
    const open = `[${key}=`;
    const i = text.indexOf(open);
    if (i === -1) return null;
    const j = text.indexOf("]", i + open.length);
    if (j === -1) return null;
    return text.slice(i + open.length, j).trim().replace(/^['"]|['"]$/g, "");
  } catch { return null; }
}

function preferTarget(numeric: string[]): string | null {
  if (!numeric.length) return null;
  const pref = ["revenue","sales","profit","cogs","amount","value","target","y"];
  for (const p of pref) {
    const hit = numeric.find(c => c.toLowerCase() === p);
    if (hit) return hit;
  }
  return numeric[0] ?? null;
}

function movingAverage(arr: number[], k: number): number[] {
  if (k <= 1) return arr.slice();
  const out: number[] = [];
  for (let i=0;i<arr.length;i++) {
    const a = Math.max(0, i-k+1);
    const window = arr.slice(a, i+1);
    out.push(window.reduce((s,v)=>s+v,0)/window.length);
  }
  return out;
}

function rmse(a: number[], b: number[]): number | null {
  if (!a.length || a.length !== b.length) return null;
  const e = a.reduce((s,ai,i)=>s + Math.pow((ai - b[i]),2), 0) / a.length;
  return Math.sqrt(e);
}
function mae(a: number[], b: number[]): number | null {
  if (!a.length || a.length !== b.length) return null;
  return a.reduce((s,ai,i)=>s + Math.abs(ai - b[i]), 0) / a.length;
}

export async function POST(req: Request) {
  try {
    const body = (await req.json().catch(()=> ({}))) as PredictBody;
    const datasetId = body.datasetId || body.id;
    const question = (body.question || body.q || "").trim();

    if (!datasetId) {
      return NextResponse.json({ error: "Missing datasetId." }, { status: 400 });
    }

    const ds = loadDatasetSync(String(datasetId));
    const rows = ds.rows;

    // --- choose target (either [target=…], body.target, or auto) ---
    let target =
      parseBracket(question, "target") ||
      (typeof body.target === "string" ? body.target : null);

    const numeric = listNumericColumns(rows);
    if (!target || !numeric.includes(target)) {
      target = preferTarget(numeric);
    }
    if (!target) {
      return NextResponse.json(
        { error: "No numeric target column found. Try adding [target=<column>] to your question or upload data with numeric values." },
        { status: 400 }
      );
    }

    // --- horizon ---
    let horizon: number | null = null;
    const hintedH = parseBracket(question, "horizon");
    if (hintedH) {
      const n = Number(hintedH);
      if (Number.isFinite(n) && n > 0) horizon = Math.floor(n);
    }
    if (!horizon) {
      const m = /next\s+(\d+)/i.exec(question);
      if (m) horizon = Math.max(1, parseInt(m[1], 10));
    }
    if (!horizon) horizon = 2;

    // --- x axis (date or index) ---
    const dateCol = detectDateColumn(rows);
    const xActual: (string|number)[] = [];
    const yActual: number[] = [];
    for (const r of rows) {
      const raw = r[target as string];
      const n = typeof raw === "number" ? raw : Number(String(raw).replace(/,/g,""));
      if (!Number.isFinite(n)) continue;
      yActual.push(n);
      if (dateCol) {
        const d = new Date(r[dateCol]);
        xActual.push(isNaN(d.getTime()) ? String(r[dateCol]) : d.toISOString().slice(0,10));
      } else {
        xActual.push(yActual.length); // 1-based index
      }
    }
    if (yActual.length < 6) {
      return NextResponse.json({ error: `Not enough numeric values in "${target}" (need >= 6)` }, { status: 400 });
    }

    // --- simple forecast: MA with window k ---
    const k = Math.max(3, Math.min(12, Math.floor(yActual.length / 10)));
    const ma = movingAverage(yActual, k);

    // validation split: last horizon points
    const n = yActual.length;
    const hold = Math.min(horizon, Math.max(1, Math.floor(n * 0.2)));
    const train = yActual.slice(0, n - hold);
    const maTrain = movingAverage(train, k);
    const lastLevel = maTrain[maTrain.length - 1];
    const forecastHold = Array.from({ length: hold }, () => lastLevel);
    const yHold = yActual.slice(n - hold);

    const theRMSE = rmse(yHold, forecastHold);
    const theMAE = mae(yHold, forecastHold);

    // final horizon forecast from all data
    const lastMA = ma[ma.length - 1];
    const xForecast: (string|number)[] = [];
    const yForecast: number[] = [];
    for (let i = 1; i <= horizon; i++) {
      const lastX = xActual[xActual.length - 1];
      if (typeof lastX === "number") {
        xForecast.push((lastX as number) + i);
      } else {
        const tryDate = new Date(String(lastX));
        if (!isNaN(tryDate.getTime())) {
          tryDate.setDate(tryDate.getDate() + i);
          xForecast.push(tryDate.toISOString().slice(0,10));
        } else {
          xForecast.push(`${lastX}+${i}`);
        }
      }
      yForecast.push(lastMA);
    }

    // Build a chart-friendly points array: [{ x, actual, forecast }]
    // Use up to last 600 actual points (for rendering performance),
    // then append the forecast horizon points.
    const MAX_SHOW = 600;
    const start = Math.max(0, xActual.length - MAX_SHOW);
    const points: { x: string|number; actual: number|null; forecast: number|null }[] = [];

    for (let i = start; i < xActual.length; i++) {
      points.push({ x: xActual[i], actual: yActual[i], forecast: null });
    }
    for (let i = 0; i < xForecast.length; i++) {
      points.push({ x: xForecast[i], actual: null, forecast: yForecast[i] });
    }

    const modelName = `Moving average (window=${k})`;
    const title = `Forecast of ${target}`;
    const explain =
`### Summary for: ${question || `Forecast next ${horizon} of ${target}`}
**Task:** Forecasting  
**Method:** ${modelName}  
**Target:** **${target}**, **Horizon:** **${horizon}**  
**Validation (last ${hold}):** RMSE=${theRMSE ?? "—"}, MAE=${theMAE ?? "—"}.

**Interpretation:** Orange = forecast (flat at last moving-average level); blue = actual. Check the gap on the right to judge short-term error.`;

    const resp = {
      task: "forecast",
      labels: { title, target, horizon, model: modelName, x: (detectDateColumn(rows) ? "Date" : "Index"), y: target },
      metrics: { rmse: theRMSE, mae: theMAE },
      // Keep old shape (in case the UI reads it)
      series: [
        { name: "actual",   x: xActual,    y: yActual },
        { name: "forecast", x: xForecast,  y: yForecast },
      ],
      // Chart-friendly shape the UI can render directly
      points,
      explain
    };

    return NextResponse.json(resp);
  } catch (e: any) {
    return NextResponse.json({ error: e?.message || "predict failed" }, { status: 500 });
  }
}
