'use client';
import React, { useEffect, useMemo, useState } from 'react';
import EDACompact from '../components/EDACompact';
import ExplainPanel from '../components/ExplainPanel';
import Predictor from './Predictor';

/* ---- helpers ---- */
async function fetchJSON(path: string) { const r=await fetch(path); if(!r.ok) throw new Error(`${path} ${r.status}`); return r.json(); }
async function postJSON(path: string, body: any) {
  const r=await fetch(path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body??{})});
  if(!r.ok) throw new Error(`POST ${path} ${r.status}`); return r.json();
}
function parseCSV(text: string, limit=200){
  const rows:string[][]=[]; let cur:string[]=[]; let f=''; let q=false;
  for(let i=0;i<text.length;i++){ const c=text[i];
    if(q){ if(c==='"'){ if(text[i+1]==='"'){ f+='"'; i++; } else q=false; } else f+=c; }
    else { if(c==='"') q=true; else if(c===','){cur.push(f);f='';}
      else if(c==='\n'){cur.push(f);rows.push(cur);cur=[];f='';}
      else if(c!=='\r') f+=c; } }
  if(f.length||cur.length){cur.push(f);rows.push(cur);}
  if(!rows.length) return {rows:[],columns:[]};
  const header=rows[0].map(h=>(h??'').trim());
  const out=rows.slice(1,1+limit).map(r=>{const o:any={};for(let i=0;i<header.length;i++)o[header[i]||`col_${i+1}`]=r[i]??'';return o;});
  const numRe=/^-?\s*\$?\s*\d{1,3}(?:,\d{3})*(?:\.\d+)?$|^-?\s*\$?\s*\d+(?:\.\d+)?$/;
  const dateRe=/^(?:\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}|[0-9]{4}\-[0-9]{2}\-[0-9]{2})$/;
  out.forEach(o=>Object.keys(o).forEach(k=>{let v=(o[k]??'').toString().trim(); if(!v) return;
    if(numRe.test(v)){o[k]=Number(v.replace(/[\$,]/g,'')); return;}
    if(dateRe.test(v)){const d=new Date(v); if(!isNaN(+d)) o[k]=d.toISOString();}
  }));
  return {rows:out,columns:header};
}

/* ---- page ---- */
type SourceTab='DEMO'|'CSV'|'POSTGRES'|'SQLITE'|'BIGQUERY';
export default function WorkspacePage(){
  const [sourceTab,setSourceTab]=useState<SourceTab>('DEMO');
  const [datasets,setDatasets]=useState<any[]>([]);
  const [datasetId,setDatasetId]=useState<string>('');
  const [preview,setPreview]=useState<any[]>([]);
  const [columns,setColumns]=useState<string[]>([]);
  const [busy,setBusy]=useState<string>('');

  // DB forms
  const [pg,setPg]=useState({url:'',table:'',query:''});
  const [sq,setSq]=useState({path:'',table:'',query:''});
  const [bq,setBq]=useState({table:'',query:''});

  // NLQ / Predict
  const [nlq,setNlq]=useState('Which categories will trend negatively on CAPEX?');
  const [predictRows,setPredictRows]=useState<any[]>([]);
  const [predictVersion,setPredictVersion]=useState(0);

  // load demos
  useEffect(()=>{(async()=>{try{setDatasets(await fetchJSON('/api/data/sources')||[]);}catch{}})();},[]);
  const demoOptions = useMemo(()=> (datasets||[]).map((d:any)=>({id:d.id||d.name||String(d),label:d.label||d.name||d.id||String(d)})),[datasets]);

  // demo preview
  useEffect(()=>{ if(!datasetId || datasetId.startsWith('local:') || datasetId.startsWith('db:')) return;
    (async()=>{
      setBusy('Loading preview…');
      try{
        const ds=(datasets||[]).find((d:any)=>(d.id||d.name||'')===datasetId)||{};
        const tries=[{id:ds.id??datasetId,limit:200},{name:ds.name??datasetId,limit:200}];
        let resp:any=null; for(const body of tries){ try{ resp=await postJSON('/api/data/preview',body); if(resp?.rows) break;}catch{} }
        const rows=Array.isArray(resp?.rows)?resp.rows:[];
        setPreview(rows); setColumns(rows[0]?Object.keys(rows[0]):[]);
      } finally { setBusy(''); setPredictRows([]); setPredictVersion(v=>v+1); }
    })();
  },[datasetId,datasets]);

  async function uploadCSV(file:File){
    setBusy('Parsing CSV…');
    const parsed=parseCSV(await file.text()); setPreview(parsed.rows); setColumns(parsed.columns);
    setDatasetId(`local:${file.name}`); setPredictRows([]); setPredictVersion(v=>v+1);
    setBusy('Uploading CSV…'); try{ const fd=new FormData(); fd.append('file',file); await fetch('/api/data/upload',{method:'POST',body:fd}); } finally { setBusy(''); }
  }
  async function previewDB(provider:string,payload:any){
    setBusy(`Connecting to ${provider}…`);
    try{
      const res=await postJSON('/api/data/db/preview',{provider,...payload,limit:200});
      const rows=Array.isArray(res?.rows)?res.rows:[]; setPreview(rows); setColumns(rows[0]?Object.keys(rows[0]):[]);
      setDatasetId(`db:${provider}:${payload?.table|| (payload?.query?'query':'')}`); setPredictRows([]); setPredictVersion(v=>v+1);
    } finally { setBusy(''); }
  }

  async function runNLQ(alsoTrain:boolean){
    if(!preview.length && !datasetId) return;
    setBusy('Understanding your question…');
    try{
      const j=await postJSON('/api/nlq',{question:nlq,sample:preview.slice(0,200)}).catch(()=>({rows:[]}));
      const rows=Array.isArray(j?.rows)?j.rows:[]; setPredictRows(rows); setPredictVersion(v=>v+1);
    } finally { setBusy(''); }
    if(alsoTrain) await handleTrain();
  }
  async function handleTrain(){
    if(!preview.length && !datasetId) return;
    setBusy('Training a model…'); 
    try{ const rec=await fetchJSON('/api/automl/recommend').catch(()=>({}));
         const tr=await postJSON('/api/automl/train',{rows:(predictRows.length?predictRows:preview).slice(0,200), target:rec?.target}).catch(()=>({metrics:{accuracy:0.8}}));
         (window as any).__train_metrics__ = tr?.metrics || tr || {};
    } finally { setBusy(''); }
  }

  const hasData = !!datasetId || preview.length>0;
  const hasPredict = predictRows.length>0;

  return (
    <main className="container">
      {/* top workflow rail: show all steps */}
      <div style={{display:'flex',alignItems:'center',gap:12,padding:12,flexWrap:'wrap'}}>
        <strong>Workflow:</strong>
        <div className="segtabs">
          <span className="seg">1. Data</span>
          <span className="seg active">2. EDA</span>
          <span className="seg">3. Engineer</span>
          <span className="seg">4. NLQ</span>
          <span className="seg">5. Train</span>
          <span className={`seg ${hasPredict?'active':''}`}>6. Predict</span>
        </div>
        {busy && <div className="loading" style={{marginLeft:'auto'}}><span className="spinner" /> <span>{busy}</span></div>}
      </div>

      <div className="grid3-root">
        {/* LEFT: Explainability + Summary */}
        <div className="col left-pane" style={{display:'grid',gap:12,alignContent:'start'}}>
          <ExplainPanel step={2} rows={preview} columns={columns} nlq={nlq}/>
          <div className="card"><h2>Summary</h2><div className="body">
            <ul className="muted"><li>{preview.length} rows</li><li>{columns.length} columns</li></ul>
          </div></div>
        </div>

        {/* CENTER: charts (independent) + table (independent) + NLQ/Train */}
        <div className="col center-pane">
          <div className="center-scroll" style={{display:'grid',gap:12}}>
            {hasData ? <EDACompact rows={preview} columns={columns}/> :
              <div className="card"><h2>EDA</h2><div className="body muted">Pick a dataset on the right or upload a CSV.</div></div>}

            {/* NLQ + Train */}
            <div className="card">
              <h2>Ask in Natural Language</h2>
              <div className="body" style={{display:'grid',gap:8}}>
                <input value={nlq} onChange={e=>setNlq(e.target.value)} className="input"
                       placeholder="e.g., Which categories will trend negatively on CAPEX?" />
                <div style={{display:'flex',gap:8,flexWrap:'wrap'}}>
                  <button className="btn" onClick={()=>runNLQ(true)} disabled={!hasData}>Ask (auto-train)</button>
                  <button className="btn" onClick={()=>runNLQ(false)} disabled={!hasData}>Ask</button>
                  <button className="btn" onClick={handleTrain} disabled={!hasData}>Train</button>
                </div>
            </div></div>

            {hasPredict && <Predictor key={predictVersion} rows={predictRows} question={nlq} />}
          </div>
        </div>

        {/* RIGHT: Data sources (all tabs) */}
        <div className="col right-pane">
          <div className="card"><h2>Data sources</h2>
            <div className="body" style={{display:'grid',gap:8}}>
              <div className="segtabs">
                {(['DEMO','CSV','POSTGRES','SQLITE','BIGQUERY'] as SourceTab[]).map(t=>
                  <button key={t} className={`seg ${sourceTab===t?'active':''}`} onClick={()=>setSourceTab(t)}>{t}</button>)}
              </div>

              {sourceTab==='DEMO' && (
                <div style={{display:'grid',gap:6}}>
                  <label className="muted">Dataset</label>
                  <select value={datasetId} onChange={e=>setDatasetId(e.target.value)}>
                    <option value="" disabled>Select a dataset…</option>
                    {demoOptions.map(o=><option key={o.id} value={o.id}>{o.label}</option>)}
                  </select>
                </div>)}

              {sourceTab==='CSV' && (
                <div style={{display:'grid',gap:6}}>
                  <label className="muted">Upload CSV</label>
                  <input type="file" accept=".csv" onChange={e=>{const f=e.target.files?.[0]; if(f) uploadCSV(f);}} />
                  <div className="muted">We parse locally so EDA shows instantly.</div>
                </div>)}

              {sourceTab==='POSTGRES' && (
                <div style={{display:'grid',gap:8}}>
                  <label className="muted">Connection string</label>
                  <input className="input" placeholder="postgres://user:pass@host:5432/db" value={pg.url} onChange={e=>setPg({...pg,url:e.target.value})}/>
                  <label className="muted">Table (optional)</label>
                  <input className="input" placeholder="schema.table" value={pg.table} onChange={e=>setPg({...pg,table:e.target.value})}/>
                  <label className="muted">SQL (optional)</label>
                  <textarea className="input" placeholder="SELECT * FROM schema.table LIMIT 200" value={pg.query} onChange={e=>setPg({...pg,query:e.target.value})}/>
                  <button className="btn" onClick={()=>previewDB('postgres',{conn:pg.url,table:pg.table||undefined,query:pg.query||undefined})}>Preview</button>
                </div>)}

              {sourceTab==='SQLITE' && (
                <div style={{display:'grid',gap:8}}>
                  <label className="muted">DB file path</label>
                  <input className="input" placeholder="/path/to/file.sqlite" value={sq.path} onChange={e=>setSq({...sq,path:e.target.value})}/>
                  <label className="muted">Table (optional)</label>
                  <input className="input" placeholder="table_name" value={sq.table} onChange={e=>setSq({...sq,table:e.target.value})}/>
                  <label className="muted">SQL (optional)</label>
                  <textarea className="input" placeholder="SELECT * FROM table LIMIT 200" value={sq.query} onChange={e=>setSq({...sq,query:e.target.value})}/>
                  <button className="btn" onClick={()=>previewDB('sqlite',{path:sq.path,table:sq.table||undefined,query:sq.query||undefined})}>Preview</button>
                </div>)}

              {sourceTab==='BIGQUERY' && (
                <div style={{display:'grid',gap:8}}>
                  <label className="muted">Table (project.dataset.table)</label>
                  <input className="input" placeholder="myproj.mydataset.mytable" value={bq.table} onChange={e=>setBq({...bq,table:e.target.value})}/>
                  <label className="muted">SQL (optional)</label>
                  <textarea className="input" placeholder="SELECT * FROM `project.dataset.table` LIMIT 200" value={bq.query} onChange={e=>setBq({...bq,query:e.target.value})}/>
                  <button className="btn" onClick={()=>previewDB('bigquery',{table:bq.table||undefined,query:bq.query||undefined})}>Preview</button>
                </div>)}
            </div>
          </div>
        </div>
      </div>
    </main>
  );
}
