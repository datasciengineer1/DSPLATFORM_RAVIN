"use client";

import React, { useEffect, useMemo, useState } from "react";
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  ResponsiveContainer,
  PieChart,
  Pie,
  Cell,
  LineChart,
  Line,
  ScatterChart,
  Scatter,
  CartesianGrid,
  Legend,
} from "recharts";

// ---------- Utility fetchers (drop-in safe)
async function fetchJSON(path: string) {
  const res = await fetch(path);
  if (!res.ok) throw new Error(await res.text());
  return res.json();
}

async function postForm(path: string, formData: FormData) {
  const res = await fetch(path, { method: "POST", body: formData });
  if (!res.ok) throw new Error(await res.text());
  return res.json();
}

// ---------- Types
interface EdaKpi {
  label: string;
  value: string | number;
  hint?: string;
}

interface EdaOverview {
  rowCount: number;
  colCount: number;
  numericCount: number;
  categoricalCount: number;
  mostMissing?: { column: string; count: number }[];
}

interface DistDatum { name: string; value: number }
interface BarDatum { name: string; value: number }
interface PieDatum { name: string; value: number }
interface ScatterDatum { x: number; y: number }
interface LineDatum { name: string; value: number }

// ---------- Nice categorical palette (stable + readable)
const COLORS = [
  "#2563eb", // blue-600
  "#16a34a", // green-600
  "#f59e0b", // amber-500
  "#ef4444", // red-500
  "#a855f7", // violet-500
  "#06b6d4", // cyan-500
  "#f97316", // orange-500
  "#22c55e", // green-500
  "#3b82f6", // blue-500
  "#e11d48", // rose-600
];

// ---------- Cards & UI helpers
function Card({ children, className = "" }: React.PropsWithChildren<{ className?: string }>) {
  return (
    <div className={`bg-white dark:bg-zinc-900 rounded-2xl shadow-md border border-zinc-100 dark:border-zinc-800 ${className}`}>
      {children}
    </div>
  );
}

function CardHeader({ title, subtitle }: { title: string; subtitle?: string }) {
  return (
    <div className="p-4 pb-0">
      <div className="text-lg font-semibold tracking-tight">{title}</div>
      {subtitle ? <div className="text-sm text-zinc-500 mt-1">{subtitle}</div> : null}
    </div>
  );
}

function CardBody({ children, className = "p-4" }: React.PropsWithChildren<{ className?: string }>) {
  return <div className={className}>{children}</div>;
}

function KpiTile({ k }: { k: EdaKpi }) {
  return (
    <div className="flex flex-col justify-between rounded-xl bg-gradient-to-br from-zinc-50 to-white dark:from-zinc-900 dark:to-zinc-950 border border-zinc-100 dark:border-zinc-800 p-4 shadow-sm">
      <div className="text-xs uppercase tracking-wider text-zinc-500">{k.label}</div>
      <div className="mt-1 text-2xl font-semibold">{k.value}</div>
      {k.hint ? <div className="text-xs text-zinc-500 mt-1">{k.hint}</div> : null}
    </div>
  );
}

// ---------- Main Page
export default function EDAWorkspacePage() {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [datasetId, setDatasetId] = useState<string | null>(null);
  const [datasetName, setDatasetName] = useState<string | null>(null);

  // server payloads (shape-agnostic; we map them into UI below)
  const [summary, setSummary] = useState<any>(null);
  const [missing, setMissing] = useState<any>(null);
  const [corr, setCorr] = useState<any>(null);

  // Discover datasetId from URL or localStorage on mount
  useEffect(() => {
    const sp = typeof window !== "undefined" ? new URLSearchParams(window.location.search) : null;
    const fromUrl = sp?.get("dataset") || sp?.get("id");
    const fromStorage = typeof window !== "undefined" ? localStorage.getItem("currentDatasetId") : null;
    const fromName = typeof window !== "undefined" ? localStorage.getItem("currentDatasetName") : null;
    if (fromName) setDatasetName(fromName);
    setDatasetId(fromUrl || fromStorage || null);
  }, []);

  // Fetch when we have a datasetId
  useEffect(() => {
    if (!datasetId) return;
    let ignore = false;
    (async () => {
      try {
        setLoading(true);
        setError(null);
        const [s, m, c] = await Promise.allSettled([
          fetchJSON(`/api/eds/summary/${datasetId}`),
          fetchJSON(`/api/eds/missing/${datasetId}`),
          fetchJSON(`/api/eds/corr/${datasetId}?top=20`),
        ]);
        if (!ignore) {
          if (s.status === "fulfilled") setSummary(s.value);
          if (m.status === "fulfilled") setMissing(m.value);
          if (c.status === "fulfilled") setCorr(c.value);
        }
      } catch (e: any) {
        if (!ignore) setError(e?.message ?? "Failed to load EDA");
      } finally {
        if (!ignore) setLoading(false);
      }
    })();
    return () => { ignore = true };
  }, [datasetId]);

  // ---------- Derived UI data (robust to partial payloads)
  const kpis: EdaKpi[] = useMemo(() => {
    // Try to infer common fields from summary; otherwise show blanks safely
    const rows = summary?.rowCount ?? summary?.rows ?? summary?.n_rows ?? null;
    const cols = summary?.colCount ?? summary?.columns ?? summary?.n_cols ?? null;
    const numericCount = summary?.numericCount ?? summary?.numeric_cols ?? null;
    const categoricalCount = summary?.categoricalCount ?? summary?.categorical_cols ?? null;
    const fmt = (v: any) => (typeof v === "number" ? v.toLocaleString() : (v ?? "—"));
    return [
      { label: "Rows", value: fmt(rows) },
      { label: "Columns", value: fmt(cols) },
      { label: "Numeric", value: fmt(numericCount) },
      { label: "Categorical", value: fmt(categoricalCount) },
    ];
  }, [summary]);

  const mostMissing = useMemo(() => {
    // Expecting: [{ column, count }] or a map { col: count }
    if (!missing) return [];
    if (Array.isArray(missing)) return missing.slice(0, 6);
    if (missing?.top) return missing.top.slice(0, 6);
    if (typeof missing === "object") {
      return Object.entries(missing)
        .map(([column, count]) => ({ column, count }))
        .slice(0, 6);
    }
    return [];
  }, [missing]);

  // For demo safety, chart fallbacks
  const distCOGS = summary?.distCOGS ?? [
    { name: "0-100", value: 120 },
    { name: "100-300", value: 98 },
    { name: "300-600", value: 62 },
    { name: "600-1k", value: 34 },
  ];
  const distRevenue = summary?.distRevenue ?? [
    { name: "0-500", value: 140 },
    { name: "500-2k", value: 80 },
    { name: "2k-5k", value: 30 },
    { name: "5k+", value: 8 },
  ];
  const countsByCategory = summary?.countsByCategory ?? [
    { name: "Devices", value: 120 },
    { name: "Theater", value: 90 },
    { name: "Computers", value: 70 },
    { name: "Cables", value: 60 },
  ];
  const shareByCity = summary?.shareByCity ?? [
    { name: "SF", value: 30 },
    { name: "NYC", value: 25 },
    { name: "LA", value: 20 },
    { name: "SEA", value: 15 },
    { name: "DAL", value: 10 },
  ];
  const cogsVsRevenue: ScatterDatum[] = summary?.cogsVsRevenue ?? Array.from({ length: 40 }, (_, i) => ({
    x: 50 + i * 20, y: 30 + i * (2 + (i % 3))
  }));
  const trendCogsByMonth = summary?.trendCogsByMonth ?? [
    { name: "Jan", value: 40 },
    { name: "Feb", value: 52 },
    { name: "Mar", value: 48 },
    { name: "Apr", value: 61 },
    { name: "May", value: 55 },
    { name: "Jun", value: 63 },
  ];

  // Handle CSV upload -> expect backend to return { id, name } or { dataset: { id, name } }
  // REPLACE the entire handleCsvUpload function with this version
async function handleCsvUpload(e: React.ChangeEvent<HTMLInputElement>) {
  // capture the input element up-front (currentTarget can be null later)
  const inputEl = e.target as HTMLInputElement | null;

  const file = inputEl?.files?.[0];
  if (!file) return;

  try {
    setLoading(true);
    setError(null);

    const form = new FormData();
    form.append("file", file);

    // adjust this endpoint if yours differs
    const resp = await postForm("/api/upload/csv", form);

    const newId =
      resp?.id ?? resp?.dataset?.id ?? resp?.dataset_id ?? null;
    const newName =
      resp?.name ?? resp?.dataset?.name ?? file.name ?? null;

    if (!newId) {
      throw new Error("Upload succeeded but no dataset id found in response");
    }

    localStorage.setItem("currentDatasetId", String(newId));
    if (newName) localStorage.setItem("currentDatasetName", String(newName));

    setDatasetId(String(newId));
    setDatasetName(newName);
  } catch (err: any) {
    setError(err?.message ?? "Upload failed");
  } finally {
    setLoading(false);
    // clear file input safely
    if (inputEl) inputEl.value = "";
  }
}


  return (
    <main className="container mx-auto px-4 py-4">
      {/* Workflow header */}
      <Card className="mb-4">
        <CardBody className="p-3">
          <div className="flex flex-wrap items-center gap-2 text-sm">
            {[
              "1. Data",
              "2. EDA",
              "3. Fixes",
              "4. NLQ",
              "5. Model",
              "6. Predict/Explain",
            ].map((s, i) => (
              <div
                key={s}
                className={
                  "px-3 py-1.5 rounded-full border text-sm " +
                  (i === 1
                    ? "bg-blue-600 text-white border-blue-600"
                    : "bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300")
                }
              >
                {s}
              </div>
            ))}
          </div>
        </CardBody>
      </Card>

      {/* Top toolbar */}
      <div className="mb-4 flex flex-wrap items-center gap-3">
        <div className="text-sm text-zinc-600 dark:text-zinc-300">
          Dataset: <span className="font-medium">{datasetName ?? (datasetId ? `#${datasetId}` : "(none)")}</span>
        </div>
        <label className="text-sm text-zinc-600 dark:text-zinc-300 inline-flex items-center gap-2">
          <span className="px-2 py-1 rounded-lg border border-zinc-200 dark:border-zinc-800">Upload CSV</span>
          <input type="file" className="hidden" onChange={handleCsvUpload} />
        </label>
        {datasetId && (
          <button
            onClick={() => {
              localStorage.removeItem("currentDatasetId");
              localStorage.removeItem("currentDatasetName");
              setDatasetId(null);
              setSummary(null); setMissing(null); setCorr(null);
            }}
            className="text-sm px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-900"
          >
            Clear
          </button>
        )}
        {loading && <span className="text-sm text-zinc-500">Loading…</span>}
        {error && <span className="text-sm text-red-600">{error}</span>}
      </div>

      {!datasetId && (
        <Card className="mb-4">
          <CardBody>
            <div className="text-sm text-zinc-600 dark:text-zinc-300">
              No dataset selected. Upload a CSV or pass <code>?dataset=&lt;id&gt;</code> in the URL to load EDA automatically.
            </div>
          </CardBody>
        </Card>
      )}

      {/* Content layout */}
      <div className="grid grid-cols-12 gap-4">
        {/* Left Sidebar */}
        <div className="col-span-12 xl:col-span-3 space-y-4">
          <Card>
            <CardHeader title="Explainability" />
            <CardBody>
              {loading && <div className="text-sm text-zinc-500">Analyzing dataset…</div>}
              {!loading && (
                <ul className="list-disc ml-5 text-sm space-y-2">
                  {(summary?.insights?.length ? summary.insights : [
                    "Revenue appears right-skewed (long tail).",
                    "COGS clusters by Category suggest segment differences.",
                    "Trend shows mild seasonality across months.",
                  ]).map((s: string, idx: number) => (
                    <li key={idx}>{s}</li>
                  ))}
                </ul>
              )}
            </CardBody>
          </Card>

          <Card>
            <CardHeader title="Recommended" />
            <CardBody>
              <div className="flex flex-col gap-2">
                {(summary?.recommendations?.length ? summary.recommendations : [
                  "How does Indicator vary by Month?",
                  "Is Indicator correlated with Category_ID?",
                  "Which combination of Month, Category, Category_ID maximizes Indicator?",
                ]).map((q: string, i: number) => (
                  <button
                    key={i}
                    className="text-left rounded-xl border border-zinc-200 dark:border-zinc-800 px-3 py-2 hover:bg-zinc-50 dark:hover:bg-zinc-900"
                  >
                    {q}
                  </button>
                ))}
              </div>
            </CardBody>
          </Card>

          <Card>
            <CardHeader title="Summary" />
            <CardBody>
              <div className="grid grid-cols-2 gap-2">
                {kpis.map((k) => (
                  <KpiTile key={k.label} k={k} />
                ))}
              </div>
              {mostMissing.length ? (
                <div className="mt-4 text-sm">
                  <div className="font-medium">Most Missing</div>
                  <ul className="mt-1 space-y-1">
                    {mostMissing.map((m: any, idx: number) => (
                      <li key={idx} className="text-zinc-600 dark:text-zinc-400">
                        {m.column} <span className="text-xs">({m.count})</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}
            </CardBody>
          </Card>
        </div>

        {/* Main charts grid */}
        <div className="col-span-12 xl:col-span-6 space-y-4">
          <Card>
            <CardHeader title="2) EDA" subtitle="Auto-profiling summary & visuals" />
            <CardBody className="p-4">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {/* Distribution of COGS */}
                <Card>
                  <CardHeader title="Distribution of COGS" subtitle="Spread & skew of values" />
                  <CardBody>
                    <div className="h-48">
                      <ResponsiveContainer width="100%" height="100%">
                        <BarChart data={distCOGS}>
                          <CartesianGrid strokeDasharray="3 3" />
                          <XAxis dataKey="name" />
                          <YAxis />
                          <Tooltip />
                          <Bar dataKey="value" radius={[8,8,0,0]} />
                        </BarChart>
                      </ResponsiveContainer>
                    </div>
                  </CardBody>
                </Card>

                {/* Distribution of Revenue */}
                <Card>
                  <CardHeader title="Distribution of Revenue" />
                  <CardBody>
                    <div className="h-48">
                      <ResponsiveContainer width="100%" height="100%">
                        <BarChart data={distRevenue}>
                          <CartesianGrid strokeDasharray="3 3" />
                          <XAxis dataKey="name" />
                          <YAxis />
                          <Tooltip />
                          <Bar dataKey="value" radius={[8,8,0,0]} />
                        </BarChart>
                      </ResponsiveContainer>
                    </div>
                  </CardBody>
                </Card>

                {/* Counts by Category */}
                <Card>
                  <CardHeader title="Counts by Category" subtitle="Counts per category" />
                  <CardBody>
                    <div className="h-48">
                      <ResponsiveContainer width="100%" height="100%">
                        <BarChart data={countsByCategory}>
                          <CartesianGrid strokeDasharray="3 3" />
                          <XAxis dataKey="name" />
                          <YAxis />
                          <Tooltip />
                          <Legend />
                          <Bar dataKey="value" radius={[8,8,0,0]} />
                        </BarChart>
                      </ResponsiveContainer>
                    </div>
                  </CardBody>
                </Card>

                {/* Share of City */}
                <Card>
                  <CardHeader title="Share of City" subtitle="Relative share" />
                  <CardBody>
                    <div className="h-48">
                      <ResponsiveContainer width="100%" height="100%">
                        <PieChart>
                          <Pie data={shareByCity} dataKey="value" nameKey="name" outerRadius={80}>
                            {shareByCity.map((_: any, i: number) => (
                              <Cell key={i} fill={COLORS[i % COLORS.length]} />
                            ))}
                          </Pie>
                          <Tooltip />
                          <Legend />
                        </PieChart>
                      </ResponsiveContainer>
                    </div>
                  </CardBody>
                </Card>

                {/* COGS vs Revenue */}
                <Card>
                  <CardHeader title="COGS vs Revenue" subtitle="Relationship, clusters, outliers" />
                  <CardBody>
                    <div className="h-48">
                      <ResponsiveContainer width="100%" height="100%">
                        <ScatterChart>
                          <CartesianGrid strokeDasharray="3 3" />
                          <XAxis dataKey="x" name="COGS" />
                          <YAxis dataKey="y" name="Revenue" />
                          <Tooltip cursor={{ strokeDasharray: "3 3" }} />
                          <Scatter data={cogsVsRevenue} />
                        </ScatterChart>
                      </ResponsiveContainer>
                    </div>
                  </CardBody>
                </Card>

                {/* Trend of COGS by Month */}
                <Card>
                  <CardHeader title="Trend of COGS by Month" subtitle="Trend over time" />
                  <CardBody>
                    <div className="h-48">
                      <ResponsiveContainer width="100%" height="100%">
                        <LineChart data={trendCogsByMonth}>
                          <CartesianGrid strokeDasharray="3 3" />
                          <XAxis dataKey="name" />
                          <YAxis />
                          <Tooltip />
                          <Line type="monotone" dataKey="value" dot={false} strokeWidth={2} />
                        </LineChart>
                      </ResponsiveContainer>
                    </div>
                  </CardBody>
                </Card>
              </div>
            </CardBody>
          </Card>

          {/* Data preview (if server returns it under summary.preview) */}
          <Card>
            <CardHeader title="Preview (15/pg)" />
            <CardBody>
              <div className="overflow-auto">
                <table className="min-w-full text-sm">
                  <thead className="sticky top-0 bg-zinc-50 dark:bg-zinc-900">
                    <tr>
                      {Object.keys((summary?.preview?.[0]) ?? {
                        Month: "",
                        Category_ID: "",
                        Category: "",
                        Subcategory_ID: "",
                        Subcategory: "",
                        Product_ID: "",
                        Product: "",
                      }).map((h: string) => (
                        <th key={h} className="px-3 py-2 text-left font-medium text-zinc-600 dark:text-zinc-300 border-b">
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {(summary?.preview ?? [
                      { Month: "Jan-01-2024", Category_ID: 1, Category: "Devices", Subcategory_ID: 1, Subcategory: "Tablets", Product_ID: 1, Product: "S" },
                      { Month: "Jul-01-2024", Category_ID: 2, Category: "Theater", Subcategory_ID: 2, Subcategory: "TV", Product_ID: 2, Product: "50" },
                    ]).map((row: any, idx: number) => (
                      <tr key={idx} className={idx % 2 ? "bg-white/50 dark:bg-zinc-950" : "bg-zinc-50/50 dark:bg-zinc-900/40"}>
                        {Object.values(row).map((v: any, j: number) => (
                          <td key={j} className="px-3 py-2 border-b text-zinc-800 dark:text-zinc-200 whitespace-nowrap">
                            {String(v)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div className="flex justify-end gap-2 pt-3">
                <button className="px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800">Back</button>
                <button className="px-3 py-1.5 rounded-lg bg-blue-600 text-white">Next</button>
              </div>
            </CardBody>
          </Card>
        </div>

        {/* Right Properties panel */}
        <div className="col-span-12 xl:col-span-3 space-y-4">
          <Card>
            <CardHeader title="Properties" />
            <CardBody>
              <div className="text-sm">
                <div className="text-zinc-500">Dataset:</div>
                <div className="font-medium">{datasetName ?? (datasetId ? `#${datasetId}` : "(none)")}</div>
              </div>
            </CardBody>
          </Card>

          <Card>
            <CardHeader title="Data sources" />
            <CardBody>
              <div className="flex flex-wrap gap-2">
                {["DEMO", "CSV", "POSTGRES", "SQLITE", "BIGQUERY"].map((s) => (
                  <span key={s} className={`px-3 py-1.5 rounded-full text-xs border ${s === "CSV" ? "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-900" : "border-zinc-200 dark:border-zinc-800"}`}>
                    {s}
                  </span>
                ))}
              </div>
              <div className="mt-3">
                <label className="text-sm text-zinc-600 dark:text-zinc-300">Upload CSV</label>
                <div className="mt-1 flex items-center gap-2">
                  <input type="file" className="text-sm" onChange={handleCsvUpload} />
                </div>
              </div>
            </CardBody>
          </Card>
        </div>
      </div>
    </main>
  );
}

