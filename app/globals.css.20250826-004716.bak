
html,body{margin:0;padding:0;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
.container{max-width:1400px;margin:0 auto;padding:16px}
.card{border:1px solid #0002;border-radius:12px;background:#fff0}
.card h2{margin:0;font-size:16px;padding:12px 16px;border-bottom:1px solid #0002}
.card .body{padding:12px 16px}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.grid{display:grid;gap:12px}
@media(min-width:640px){.grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(min-width:1280px){.grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}}
.btn{padding:8px 12px;border-radius:8px;border:1px solid #0002;background:#eee;cursor:pointer}
.btn:hover{background:#e2e2e2}.btn:disabled{opacity:.6;cursor:not-allowed}
.input,.select,textarea{padding:8px 10px;border-radius:8px;border:1px solid #0002;width:100%}
.table{width:100%;border-collapse:collapse}
.table thead th{text-align:left;padding:8px 10px;position:sticky;top:0;background:#00000008;border-bottom:1px solid #0002}
.table tbody td{padding:6px 10px;border-bottom:1px solid #0001}
.muted{opacity:.8;font-size:12px}
pre{white-space:pre-wrap;word-wrap:break-word}
svg{display:block;width:100%;height:auto}

/* Workspace 3-column collapses gracefully */
@media (max-width: 1200px){ main.container { grid-template-columns: 1fr !important; } }

/* Stepper buttons wrap and highlight the active step */
.card .body .btn { white-space: nowrap; }
@media (max-width: 1200px){
  main.container { grid-template-columns: 1fr !important; }
}

/* prettier cards & headings */
.card { border-radius: 14px; border: 1px solid #e5e7eb; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
.card h2 { font-size: 16px; margin: 0 0 8px; }
.body { font-size: 14px; }
.table th, .table td { font-size: 13px; }
.muted { color: #6b7280; }

/* section spacing */
.container { padding-bottom: 24px; }

/* grid helper */
.grid.cols-3 { display:grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap:12px; }
@media (max-width: 1200px){ .grid.cols-3 { grid-template-columns: 1fr; } }

.btn { border-radius:10px; border:1px solid #e5e7eb; padding:6px 10px; cursor:pointer; background:#fff;}
.btn:disabled { opacity: .5; cursor: default; }
.input, .select { border:1px solid #e5e7eb; border-radius:10px; padding:6px 10px; width:100%; }

/* prettier cards & headings */
.card { border-radius: 14px; border: 1px solid #e5e7eb; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
.card h2 { font-size: 16px; margin: 0 0 8px; }
.body { font-size: 14px; }
.table th, .table td { font-size: 13px; }
.muted { color: #6b7280; }
.container { padding-bottom: 24px; }
.grid.cols-3 { display:grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap:12px; }
@media (max-width: 1200px){ .grid.cols-3 { grid-template-columns: 1fr; } }
.btn { border-radius:10px; border:1px solid #e5e7eb; padding:6px 10px; cursor:pointer; background:#fff;}
.btn:disabled { opacity: .5; cursor: default; }
.input, .select { border:1px solid #e5e7eb; border-radius:10px; padding:6px 10px; width:100%; }

/* tabs & grid */
.tabs { display:flex; gap:8px; flex-wrap:wrap; }
.tab { border:1px solid #e5e7eb; padding:6px 10px; border-radius:999px; background:#fff; cursor:pointer; }
.tab.active { border-color:#2563eb; color:#2563eb; }
.grid3 { display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:12px; }
@media (max-width: 1024px){ .grid3 { grid-template-columns: 1fr; } }

/* responsive content cards and stepper */
@media (max-width: 900px){
  .card h2 { font-size: 15px; }
  .table th, .table td { font-size: 12px; }
}

/* 3-col root layout */
.grid3-root { display:grid; grid-template-columns: 280px 1fr 320px; gap:12px; }
.stack > * + * { margin-top:12px; }

@media (max-width: 1200px){
  .grid3-root { grid-template-columns: 1fr; }
}

/* tabs & inputs already defined earlier */

.toolbar { display:flex; gap:8px; }
.explain-box {
  white-space: pre-wrap;
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 13px;
  line-height: 1.5;
}

/* Theme polish */
:root{
  --brand:#2563eb;
  --brand-600:#1d4ed8;
  --bg:#f7f9fc;
  --card:#ffffff;
  --muted:#64748b;
}
body { background: var(--bg); }

/* Cards & buttons */
.card { background: var(--card); border:1px solid #e5e7eb; border-radius:12px; box-shadow: 0 1px 2px rgba(16,24,40,.04); }
.card h2 { margin:0; padding:12px 12px 0 12px; }
.card .body { padding:12px; }

.btn { border:1px solid #e5e7eb; background:#fff; padding:6px 10px; border-radius:10px; cursor:pointer; }
.btn:hover { border-color: var(--brand); color: var(--brand); }
.btn:disabled { opacity:.6; cursor:default; }

/* Inputs */
.input, .select, textarea.input {
  width:100%; border:1px solid #e5e7eb; border-radius:8px; padding:8px 10px; background:#fff;
}

/* Table */
.table { width:100%; border-collapse:separate; border-spacing:0; }
.table th, .table td { text-align:left; padding:8px 10px; border-bottom:1px solid #eef2f7; font-size:13px; }
.table th { position:sticky; top:0; background:#fafbff; z-index:1; }
.pager { display:flex; justify-content:space-between; align-items:center; margin-top:8px; }
.pager-btns { display:flex; gap:8px; }

/* Toolbar & flags */
.toolbar { display:flex; gap:8px; }
.flag { display:flex; gap:8px; align-items:center; }

/* Explainability scroll panel */
.explain-panel { max-height: 260px; min-height: 160px; overflow:auto; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; padding:8px; }
.explain-text { white-space: pre-wrap; margin:0; font-size:13px; line-height:1.5; }

/* Chips (recommendations) */
.chip-list { display:flex; flex-wrap:wrap; gap:8px; }
.chip { border:1px solid #e5e7eb; padding:6px 10px; border-radius:999px; background:#fff; cursor:pointer; max-width:100%; white-space:normal; text-align:left; }
.chip:hover { border-color: var(--brand); color: var(--brand); }

/* Rec model grid */
.rec-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap:12px; }
.rec-card { border:1px solid #e5e7eb; border-radius:12px; background:#fff; padding:10px; cursor:pointer; }
.rec-card.active { border-color: var(--brand); box-shadow: 0 0 0 2px rgba(37,99,235,.1); }
.rec-title { font-weight:600; margin-bottom:6px; }
.rec-why { color:var(--muted); font-size:13px; }

/* Alerts & loaders */
.alert { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; padding:8px 10px; border-radius:8px; }
.loading { display:flex; gap:8px; align-items:center; color:var(--muted); }
.spinner, .spinner.lg { width:14px; height:14px; border:2px solid #cbd5e1; border-top-color: var(--brand); border-radius:50%; animation: spin 1s linear infinite; }
.spinner.lg { width:24px; height:24px; }

@keyframes spin { to { transform: rotate(360deg); } }

/* Training overlay */
.overlay { position:fixed; inset:0; background:rgba(15,23,42,.25); display:flex; align-items:center; justify-content:center; z-index:50; }
.overlay-box { background:#fff; border-radius:12px; border:1px solid #e5e7eb; padding:20px 24px; display:grid; gap:8px; place-items:center; min-width:260px; }

/* Responsive grid */
.stack > * + * { margin-top:12px; }
@media (max-width: 1200px){ .stack > * + * { margin-top:12px; } }

/* ---- Layout stability fix (prevents center column from stretching) ---- */
.container{max-width:1280px;margin:0 auto;padding:12px;}
.grid3-root{
  display:grid;
  grid-template-columns: 280px minmax(720px, 1fr) 320px; /* keep center >=720px but bounded by container */
  gap:12px;
  align-items:start;
}
/* Slightly tighter cap on ultra-wide monitors */
@media (min-width:1600px){ .container{max-width:1320px;} }
/* Mobile stacks as before */
@media (max-width:1200px){ .grid3-root{grid-template-columns:1fr;} }

/* --- Layout stability (prevents center from forcing grid wider) --- */
.grid3-root {
  display: grid;
  grid-template-columns: 280px 1fr 320px;
  gap: 12px;
  align-items: start;
}
.grid3-root > .col { min-width: 0; }             /* critical! allows overflow-x scroll inside */
.container { max-width: 1280px; margin: 0 auto; padding: 12px; }
@media (min-width:1600px){ .container{ max-width: 1320px; } }
@media (max-width:1200px){ .grid3-root{ grid-template-columns: 1fr; } }

/* Chips never spill */
.chip-list { display:flex; flex-direction:column; gap:8px; }
.chip { display:block; max-width:100%; white-space:normal; word-break:break-word;
        border:1px solid #e5e7eb; border-radius:999px; padding:8px 12px; background:#fff; text-align:left; }

/* Sticky "Back / Next" within center column */
.step-cta {
  position: sticky; bottom: 8px; z-index: 5;
  margin-top: 8px; padding: 10px 12px;
  background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
  display:flex; justify-content: space-between; align-items:center; gap:12px;
  box-shadow: 0 6px 16px rgba(16,24,40,.06);
}
.step-cta .right { display:flex; gap:8px; }

/* Small loader */
.loading { display:flex; gap:8px; align-items:center; color:#64748b; }
.spinner { width:14px; height:14px; border:2px solid #cbd5e1; border-top-color:#2563eb; border-radius:50%; animation:spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Horizontal scroll container that NEVER expands the grid track */
.scroll-x { overflow-x:auto; max-width:100%; }

/* Tables won't force parent wider than the center column */
.table { width:max-content; min-width:100%; table-layout:auto; }
.grid3-root > .col { min-width:0; } /* critical for grids with wide children */

/* Small training overlay (reused) */
.overlay { position:fixed; inset:0; background:rgba(15,23,42,.25); display:flex; align-items:center; justify-content:center; z-index:50; }
.overlay-box { background:#fff; border-radius:12px; border:1px solid #e5e7eb; padding:18px 22px; display:grid; gap:8px; place-items:center; min-width:260px; }
.spinner, .spinner.lg { width:14px; height:14px; border:2px solid #cbd5e1; border-top-color:#2563eb; border-radius:50%; animation: spin 1s linear infinite; }
.spinner.lg { width:24px; height:24px; }
@keyframes spin { to { transform: rotate(360deg); } }


/* ===== Layout stability & tables ===== */
.container{max-width:1280px;margin:0 auto;padding:12px;}
@media (min-width:1600px){ .container{max-width:1320px;} }

.grid3-root{display:grid;grid-template-columns:280px 1fr 320px;gap:12px;align-items:start;}
.grid3-root>.col{min-width:0;}             /* critical: allow wide children to scroll instead of stretching grid */
@media (max-width:1200px){ .grid3-root{grid-template-columns:1fr;} }

.scroll-x{overflow-x:auto;max-width:100%;}
.table{width:max-content;min-width:100%;table-layout:auto;} /* long tables won’t expand grid */

/* Chips contained (no spill) */
.chip-list{display:flex;flex-direction:column;gap:8px;}
.chip{display:block;max-width:100%;white-space:normal;word-break:break-word;border:1px solid #e5e7eb;border-radius:999px;padding:8px 12px;background:#fff;text-align:left;}

/* Sticky step controls inside center column */
