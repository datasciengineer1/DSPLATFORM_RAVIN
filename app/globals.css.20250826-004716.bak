@keyframes spin{to{transform:rotate(360deg)}}

.overlay{position:fixed;inset:0;background:rgba(15,23,42,.25);display:flex;align-items:center;justify-content:center;z-index:50;}
.overlay-box{background:#fff;border-radius:12px;border:1px solid #e5e7eb;padding:18px 22px;display:grid;gap:8px;place-items:center;min-width:260px;}

/* ----- Layout caps ----- */
.container{max-width:1280px;margin:0 auto;padding:12px;}
@media (min-width:1600px){ .container{max-width:1320px;} }

.grid3-root{display:grid;grid-template-columns:280px 1fr 320px;gap:12px;align-items:start;}
.grid3-root>.col{min-width:0;} /* critical: wide content scrolls instead of stretching the grid */
@media (max-width:1200px){ .grid3-root{grid-template-columns:1fr;} }

/* Column-scoped scrolling (keeps page height stable) */
.left-pane,.center-pane,.right-pane{max-height:calc(100vh - 180px);overflow:auto;}
/* Tables never force grid wider */
.scroll-x{overflow-x:auto;max-width:100%;}
.table{width:max-content;min-width:100%;table-layout:auto;}

/* Chips & loaders */
.chip-list{display:flex;flex-direction:column;gap:8px;}
.chip{display:block;max-width:100%;white-space:normal;word-break:break-word;border:1px solid #e5e7eb;border-radius:999px;padding:8px 12px;background:#fff;text-align:left;}
.loading{display:flex;gap:8px;align-items:center;color:#64748b;}
.spinner,.spinner.lg{width:14px;height:14px;border:2px solid #cbd5e1;border-top-color:#2563eb;border-radius:50%;animation:spin 1s linear infinite;}
.spinner.lg{width:24px;height:24px;}
@keyframes spin{to{transform:rotate(360deg)}}

/* Sticky step controls inside center panel */
.step-cta{position:sticky;bottom:8px;z-index:5;margin-top:8px;padding:10px 12px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;display:flex;justify-content:space-between;align-items:center;gap:12px;box-shadow:0 6px 16px rgba(16,24,40,.06);}
.step-cta .right{display:flex;gap:8px;}

/* Overlay */
.overlay{position:fixed;inset:0;background:rgba(15,23,42,.25);display:flex;align-items:center;justify-content:center;z-index:50;}
.overlay-box{background:#fff;border-radius:12px;border:1px solid #e5e7eb;padding:18px 22px;display:grid;gap:8px;place-items:center;min-width:260px;}

/* Chart captions */
.chart-caption{font-size:12px;color:#64748b;margin-top:6px;}
.explain-box{background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:10px;}

/* --- Column-scoped scroll; keep full page height stable --- */
.left-pane,.center-pane,.right-pane{max-height:calc(100vh - 180px);overflow:auto;}

/* Prevent content hiding behind sticky footer in center pane */
.center-pane{position:relative;padding-bottom:72px;}
.spacer-cta{height:64px;} /* extra breathing room above sticky bar */

/* Keep wide tables inside the center card */
.grid3-root>.col{min-width:0;}
.scroll-x{overflow-x:auto;max-width:100%;}
.table{width:max-content;min-width:100%;table-layout:auto;}

/* Explain box scrolls inside itself */
.explain-box{background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:10px;max-height:260px;overflow:auto;}

/* Sticky Back/Next inside center pane */
.step-cta{position:sticky;bottom:8px;z-index:5;margin-top:8px;padding:10px 12px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;display:flex;justify-content:space-between;align-items:center;gap:12px;box-shadow:0 6px 16px rgba(16,24,40,.06);}
.step-cta .right{display:flex;gap:8px;}

/* Segmented tabs for AutoML vs Manual */
.segtabs{display:flex;gap:8px;flex-wrap:wrap;}
.segtabs .seg{border:1px solid #e5e7eb;border-radius:999px;background:#fff;padding:6px 12px;cursor:pointer;}
.segtabs .seg.active{border-color:#2563eb;background:#eff6ff;}

/* Loaders */
.loading{display:flex;gap:8px;align-items:center;color:#64748b;}
.spinner,.spinner.lg{width:14px;height:14px;border:2px solid #cbd5e1;border-top-color:#2563eb;border-radius:50%;animation:spin 1s linear infinite;}
.spinner.lg{width:24px;height:24px;}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== Viewport layout: no page-level scroll ===== */
html, body, #__next { height: 100%; overflow: hidden; }
main.container { height: 100%; display: flex; flex-direction: column; }

/* A wrapper so the top “Workflow” card sits above the scrollable grid */
.viewport { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 12px; }

/* The 3-column grid fills the remaining viewport and scrolls by column */
.grid3-root {
  flex: 1 1 auto; min-height: 0;
  display: grid; gap: 12px; align-items: start;
  grid-template-columns: 280px 1fr 320px;
}
.grid3-root > .col { min-width: 0; }            /* don’t stretch the grid when content is wide */
.left-pane, .center-pane, .right-pane { min-height: 0; overflow: auto; }

/* Tables stay inside the center pane; horizontal scroll only */
.scroll-x { overflow-x: auto; max-width: 100%; }
.table { width: max-content; min-width: 100%; table-layout: auto; }

/* Sticky footer inside center pane + clearance so rows aren’t covered */
.center-pane { position: relative; padding-bottom: 72px; }
.step-cta { position: sticky; bottom: 8px; z-index: 5;
  margin-top: 8px; padding: 10px 12px; background: #fff;
  border: 1px solid #e5e7eb; border-radius: 12px;
  display: flex; justify-content: space-between; align-items: center; gap: 12px;
  box-shadow: 0 6px 16px rgba(16,24,40,.06);
}
.step-cta .right { display: flex; gap: 8px; }
.spacer-cta { height: 64px; }                   /* ensures last card never hides under sticky bar */

/* Explain box scrolls inside its own panel (left column) */
.explain-box { background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px;
  padding:10px; max-height:260px; overflow:auto; white-space:pre-wrap; }

/* NLQ loader + spinner */
.loading { display:flex; gap:8px; align-items:center; color:#64748b; }
.spinner, .spinner.lg { width:14px; height:14px; border:2px solid #cbd5e1; border-top-color:#2563eb;
  border-radius:50%; animation: spin 1s linear infinite; }
.spinner.lg { width:24px; height:24px; }
@keyframes spin { to { transform: rotate(360deg) } }

/* AutoML vs Manual segmented control (already present) */
.segtabs { display:flex; gap:8px; flex-wrap:wrap; }
.segtabs .seg { border:1px solid #e5e7eb; border-radius:999px; background:#fff; padding:6px 12px; cursor:pointer; }
.segtabs .seg.active { border-color:#2563eb; background:#eff6ff; }

/* ===== Viewport layout: no page-level scroll ===== */
html, body, #__next { height: 100%; overflow: hidden; }
main.container { height: 100dvh; display: flex; flex-direction: column; }
.viewport { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 12px; }

/* Three-column grid fills the viewport; each column scrolls independently */
.grid3-root {
  flex: 1 1 auto; min-height: 0;
  display: grid; gap: 12px; align-items: start;
  grid-template-columns: 280px 1fr 320px;
}
.grid3-root > .col { min-width: 0; }
.left-pane, .right-pane { min-height: 0; overflow: auto; overscroll-behavior: contain; }

/* Center column: the content area scrolls; footer stays put */
.center-pane { min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
.center-scroll { flex: 1 1 auto; min-height: 0; overflow: auto; overscroll-behavior: contain; padding-bottom: 12px; }

/* Tables: never break layout */
.scroll-x { overflow-x: auto; max-width: 100%; }
.table { width: max-content; min-width: 100%; table-layout: auto; }

/* Footer (inside center column) */
.step-cta { margin-top: 8px; padding: 10px 12px; background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
  display: flex; justify-content: space-between; align-items: center; gap: 12px; box-shadow: 0 6px 16px rgba(16,24,40,.06); }
.step-cta .right { display: flex; gap: 8px; }

/* Explain panel scrolls inside itself (no page scroll) */
.explain-box { background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; padding:10px; max-height:260px; overflow:auto; white-space:pre-wrap; }

/* Progress overlay with steps */
.overlay { position:fixed; inset:0; background:rgba(15,23,42,.25); display:flex; align-items:center; justify-content:center; z-index:50; }
.overlay-box { background:#fff; border-radius:12px; border:1px solid #e5e7eb; padding:18px 22px; min-width:320px; display:grid; gap:10px; }
.progress-steps { display:grid; gap:6px; }
.step-row { display:flex; align-items:center; gap:8px; font-size:14px; }
.step-dot { width:10px; height:10px; border-radius:999px; background:#cbd5e1; }
.step-dot.active { background:#2563eb; }
.step-dot.done { background:#10b981; }

/* Tiny loader */
.loading { display:flex; gap:8px; align-items:center; color:#64748b; }
.spinner { width:14px; height:14px; border:2px solid #cbd5e1; border-top-color:#2563eb; border-radius:50%; animation:spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg) } }

/* Insight card caption */
.chart-caption{font-size:12px;color:#64748b;margin-top:6px;}
/* --- Layout hardening for 3-col app --- */
:root { --card-bg:#fff; --chrome:#fafafa; }
main.container { height:100vh; display:flex; flex-direction:column; background:var(--chrome); }
.viewport { flex:1; min-height:0; display:flex; flex-direction:column; }
.grid3-root{ display:grid; gap:12px; grid-template-columns:280px 1fr 320px; height:calc(100vh - 120px); }
.col{ min-height:0; overflow:hidden; }
.left-pane,.right-pane{ overflow:auto; }
.center-pane{ min-height:0; display:flex; flex-direction:column; }
.center-scroll{ flex:1; min-height:0; overflow:auto; padding-bottom:96px; }
.step-cta{ position:sticky; bottom:0; background:var(--card-bg); border-top:1px solid #0002; padding:8px 12px; display:flex; justify-content:space-between; align-items:center; }

.card{ background:var(--card-bg); border:1px solid #0002; border-radius:12px; }
.card>.body{ padding:10px; }
.explain-box{ background:#f6f8fb; border:1px solid #0002; border-radius:8px; padding:10px; max-height:220px; overflow:auto; }
.scroll-x{ overflow:auto; }

.loading{ display:flex; gap:8px; align-items:center; }
.spinner{ width:14px; height:14px; border-radius:50%; border:2px solid #0003; border-top-color:#2563eb; animation:spin 1s linear infinite; }
@keyframes spin{ to{ transform:rotate(360deg) } }

.chip-list{ display:flex; flex-wrap:wrap; gap:6px; }
.chip{ border:1px solid #2563eb55; background:#eef3ff; color:#2563eb; padding:6px 10px; border-radius:999px; cursor:pointer; }
.segtabs{ display:flex; gap:4px; }
.seg{ padding:6px 10px; border:1px solid #0002; background:#fff; border-radius:8px; }
.seg.active{ border-color:#2563eb; box-shadow:0 0 0 2px #2563eb22 inset; }
.card-grid{ display:grid; gap:12px; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); }
.table-wrapper{ overflow:auto; max-height:420px; }

/* Scrollable explainability panel */
.explain-box{
  max-height:260px; overflow:auto; padding:10px; border:1px dashed var(--border,#e5e7eb);
  border-radius:10px; background:#fafafa; white-space:pre-wrap; font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
}

/* Extra breathing room between chart grid and table */
.center-scroll > .card + .card { margin-top: 4px; }

/* === Layout refinements for EDA === */
.grid3-root{
  display:grid;
  grid-template-columns: 280px 1fr 340px;
  gap:12px;
  align-items:start;
}

/* center stack can scroll independently without cutting charts */
.center-pane { min-width:0; }
.center-scroll{
  display:grid;
  gap:12px;
  max-height: calc(100vh - 220px);   /* keeps the bar visible */
  overflow: auto;                    /* internal scroll like the old build */
  padding-bottom: 72px;              /* room above the sticky bar */
}

/* chart sizing so they never clip */
.card .body svg{
  display:block;
  width:100%;
  height:180px; /* consistent height across small cards */
}

/* only the preview table scrolls */
.table-wrap{
  max-height: 320px;
  overflow: auto;
}

/* sticky Next/Back bar inside the center pane */
.statusbar{
  position: sticky;
  bottom: 0;
  z-index: 5;
  background: var(--card-bg, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 12px;
  padding: 12px;
}

/* small utilities */
.muted{ color: #6b7280; }
.segtabs .seg.active{ background:#111827; color:#fff; }
.btn{ padding:6px 10px; border:1px solid #d1d5db; border-radius:8px; background:#fff; }
.btn:disabled{ opacity:.5; }
