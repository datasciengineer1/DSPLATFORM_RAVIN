'use client';
import React, {useMemo, useState} from 'react';

type Row = Record<string, any>;
const isNum = (x:any)=> typeof x==='number' && Number.isFinite(x);
const asDate = (x:any)=>{ const d = new Date(x); return isNaN(+d)? null : d; };

function Card({title,children}:{title:string;children:React.ReactNode}){
  return <div className="card"><h2>{title}</h2><div className="body">{children}</div></div>;
}

/* --- simple SVG charts (no libs) --- */
function Hist({values}:{values:number[]}) {
  if(!values.length) return <div className="muted">—</div>;
  const bins = 20, min = Math.min(...values), max = Math.max(...values);
  const w=280, h=160, p=24;
  const counts = Array(bins).fill(0);
  const rng = max-min || 1;
  values.forEach(v=>{
    const i=Math.min(bins-1, Math.max(0, Math.floor((v-min)/rng*bins)));
    counts[i]++; });
  const maxC = Math.max(...counts,1), bw=(w-2*p)/bins;
  return <svg viewBox={`0 0 ${w} ${h}`}>
    {counts.map((c,i)=>{const x=p+i*bw, y=h-p-(c/maxC)*(h-2*p);
      return <rect key={i} x={x} y={y} width={Math.max(1,bw-2)} height={h-p-y} fill="rgba(37,99,235,.75)"/>})}
    <text x={w/2} y={h-6} textAnchor="middle" fontSize="10" fill="#555">value →</text>
    <text x={6} y={12} fontSize="10" fill="#555">count</text>
  </svg>;
}

function Bar({pairs}:{pairs:{k:string,v:number}[]}) {
  if(!pairs.length) return <div className="muted">—</div>;
  const w=280,h=160,p=24, maxV=Math.max(...pairs.map(p=>p.v),1);
  const bw=(w-2*p)/pairs.length;
  return <svg viewBox={`0 0 ${w} ${h}`}>
    {pairs.map((p_,i)=>{const x=p+i*bw, y=h-p-(p_.v/maxV)*(h-2*p);
      return <g key={i}>
        <rect x={x} y={y} width={Math.max(1,bw-8)} height={h-p-y} fill="rgba(37,99,235,.75)"/>
        <text x={x+bw/2} y={h-8} fontSize="9" textAnchor="middle" fill="#555">{p_.k.slice(0,6)}</text>
      </g>;})}
    <text x={6} y={12} fontSize="10" fill="#555">count</text>
  </svg>;
}

function Line({points}:{points:{x:string,y:number}[]}) {
  if(!points.length) return <div className="muted">—</div>;
  const w=280,h=160,p=24;
  const ys=points.map(p=>p.y), min=Math.min(...ys), max=Math.max(...ys);
  const rng=max-min||1;
  const poly=points.map((p,i)=>{
    const xp=p+(i as any); // dummy to keep TS quiet
    const x=p=0; // placeholder no-op
    return '';
  });
  const path=points.map((p,i)=>{
    const x=p*0; // (satisfy TS) not used
    return '';
  });
  // simpler polyline:
  const xs = points.map((_,i)=> i);
  const step=(w-2*p)/Math.max(1, points.length-1);
  const pts = points.map((d,i)=>`${p+i*step},${h-p-((d.y-min)/rng)*(h-2*p)}`).join(' ');
  return <svg viewBox={`0 0 ${w} ${h}`} style={{border:'1px solid #0001',borderRadius:8}}>
    <polyline points={pts} fill="none" stroke="#2563eb" strokeWidth="2"/>
    <rect x={p} y={p} width={w-2*p} height={h-2*p} fill="none" stroke="#0002"/>
  </svg>;
}

/* --- Preview table with 15/pg --- */
function PreviewTable({rows}:{rows:Row[]}){
  const [page,setPage]=useState(0);
  const pageSize=15;
  const cols = Object.keys(rows[0]||{});
  const slice = rows.slice(page*pageSize, page*pageSize+pageSize);
  const pages = Math.ceil(rows.length/pageSize)||1;
  return (
    <div>
      <div className="table-wrapper">
        <table className="table">
          <thead><tr>{cols.map(c=><th key={c}>{c}</th>)}</tr></thead>
          <tbody>
            {slice.map((r,i)=>(
              <tr key={i}>{cols.map(c=><td key={c}>{String(r[c])}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <div style={{display:'flex',justifyContent:'space-between',marginTop:8}}>
        <div className="muted">Page {page+1} / {pages} · showing {slice.length} of {rows.length}</div>
        <div style={{display:'flex',gap:8}}>
          <button className="btn" disabled={page===0} onClick={()=>setPage(p=>Math.max(0,p-1))}>Prev</button>
          <button className="btn" disabled={page>=pages-1} onClick={()=>setPage(p=>Math.min(pages-1,p+1))}>Next</button>
        </div>
      </div>
    </div>
  );
}

export default function EDACompact({rows, columns}:{rows:Row[]; columns:string[]}) {
  const sample = rows.slice(0, 200);
  const {numeric,categorical,dateCol} = useMemo(()=>{
    const num = columns.filter(c=> sample.some(r=>isNum(r[c])));
    const cat = columns.filter(c=> !num.includes(c));
    const date = columns.find(c=> c.toLowerCase().includes('date') || c.toLowerCase().includes('month'));
    return {numeric:num,categorical:cat,dateCol:date};
  },[rows,columns]);

  // auto-pick
  const num1 = numeric[0], num2 = numeric[1], cat1 = categorical[0];

  const histVals1 = useMemo(()=> num1? sample.map(r=>r[num1]).filter(isNum) as number[] : [], [sample,num1]);
  const histVals2 = useMemo(()=> num2? sample.map(r=>r[num2]).filter(isNum) as number[] : [], [sample,num2]);

  const catPairs = useMemo(()=> {
    if(!cat1) return [];
    const m = new Map<string,number>();
    sample.forEach(r=>{ const k=String(r[cat1]??'—'); m.set(k,(m.get(k)||0)+1); });
    return Array.from(m.entries()).sort((a,b)=>b[1]-a[1]).slice(0,10).map(([k,v])=>({k,v}));
  },[sample,cat1]);

  const trend = useMemo(()=>{
    const metric = num1;
    if(!dateCol || !metric) return [] as {x:string,y:number}[];
    const m = new Map<string,number>();
    sample.forEach(r=>{
      const d=asDate(r[dateCol]); const v=r[metric];
      if(!d || !isNum(v)) return;
      const k=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
      m.set(k,(m.get(k)||0)+v);
    });
    return Array.from(m.entries()).sort((a,b)=>a[0].localeCompare(b[0])).map(([x,y])=>({x,y}));
  },[sample,dateCol,num1]);

  return (
    <div style={{display:'grid', gap:12}}>
      <div className="card-grid">
        <Card title={num1?`Distribution of ${num1}`:'Distribution'}>
          {num1 ? <Hist values={histVals1}/> : <div className="muted">No numeric column found.</div>}
        </Card>
        <Card title={num2?`Distribution of ${num2}`:'Counts by category'}>
          {num2 ? <Hist values={histVals2}/> : <Bar pairs={catPairs}/>}
        </Card>
        <Card title={cat1?`Counts by ${cat1}`:'Category counts'}>
          <Bar pairs={catPairs}/>
        </Card>
        <Card title={dateCol && num1 ? `Trend of ${num1} by ${dateCol}` : 'Trend'}>
          {dateCol && num1 ? <Line points={trend}/> : <div className="muted">No date trend available.</div>}
        </Card>
      </div>

      <Card title="Preview (15/pg)">
        {rows.length ? <PreviewTable rows={rows}/> : <div className="muted">No rows yet.</div>}
      </Card>
    </div>
  );
}
