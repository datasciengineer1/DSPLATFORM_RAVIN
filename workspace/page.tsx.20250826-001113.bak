'use client';
import React, { useEffect, useMemo, useState } from 'react';
import ExplainPanel from '../components/ExplainPanel';
import EDACompact from '../components/EDACompact';

/* helpers */
async function fetchJSON(p:string){ const r=await fetch(p); if(!r.ok) throw new Error(`${p} ${r.status}`); return r.json(); }
async function postJSON(p:string,b:any){ const r=await fetch(p,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(b??{})}); if(!r.ok) throw new Error(`POST ${p} ${r.status}`); return r.json();}
function parseCSV(t:string,l=200){const R:string[][]=[],o:string[]=[];let f='',q=false;for(let i=0;i<t.length;i++){const c=t[i];if(q){if(c=='"'){if(t[i+1]=='"'){f+='"';i++;}else q=false;}else f+=c;}else{if(c=='"')q=true;else if(c==','){o.push(f);f='';}else if(c=='\n'){o.push(f);R.push(o.slice());o.length=0;f='';}else if(c!='\r')f+=c;}}if(f.length||o.length){o.push(f);R.push(o);} if(!R.length)return{rows:[],columns:[]}; const h=R[0].map(x=>(x??'').trim()); const out=R.slice(1,1+l).map(r=>{const o:any={}; for(let i=0;i<h.length;i++) o[h[i]||`col_${i+1}`]=r[i]??''; return o;}); const num=/^-?\s*\$?\s*\d{1,3}(?:,\d{3})*(?:\.\d+)?$|^-?\s*\$?\s*\d+(?:\.\d+)?$/; const dat=/^(?:\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}|[0-9]{4}\-[0-9]{2}\-[0-9]{2})$/; out.forEach(o=>Object.keys(o).forEach(k=>{let v=(o[k]??'').toString().trim(); if(!v)return; if(num.test(v)){o[k]=Number(v.replace(/[\$,]/g,'')); return;} if(dat.test(v)){const d=new Date(v); if(!isNaN(+d)) o[k]=d.toISOString();}})); return {rows:out,columns:h};}

/* page */
type SourceTab='DEMO'|'CSV'|'POSTGRES'|'SQLITE'|'BIGQUERY';
export default function WorkspacePage(){
  const [activeStep,setActiveStep]=useState(2); // 1 Data, 2 EDA, 3 Fixes, 4 NLQ, 5 Model, 6 Predict/Explain
  const [sourceTab,setSourceTab]=useState<SourceTab>('CSV');

  const [datasets,setDatasets]=useState<any[]>([]);
  const [datasetId,setDatasetId]=useState<string>('');
  const [preview,setPreview]=useState<any[]>([]);
  const [columns,setColumns]=useState<string[]>([]);
  const [busy,setBusy]=useState<string>('');

  // DB forms
  const [pg,setPg]=useState({url:'',table:'',query:''});
  const [sq,setSq]=useState({path:'',table:'',query:''});
  const [bq,setBq]=useState({table:'',query:''});

  // pagination (15/pg)
  const [page,setPage]=useState(1);
  const pageSize=15;
  const totalPages=Math.max(1,Math.ceil(preview.length/pageSize));
  const pageRows = useMemo(()=> preview.slice((page-1)*pageSize, page*pageSize),[preview,page]);

  // data sources list
  useEffect(()=>{(async()=>{try{setDatasets(await fetchJSON('/api/data/sources')||[]);}catch{}})();},[]);
  const demoOptions = useMemo(()=> (datasets||[]).map((d:any)=>({id:d.id||d.name||String(d),label:d.label||d.name||d.id||String(d)})),[datasets]);

  // DEMO preview
  useEffect(()=>{ if(!datasetId || datasetId.startsWith('local:') || datasetId.startsWith('db:')) return;
    (async()=>{
      setBusy('Loading preview…');
      try{
        const ds=(datasets||[]).find((d:any)=>(d.id||d.name||'')===datasetId)||{};
        const tries=[{id:ds.id??datasetId,limit:200},{name:ds.name??datasetId,limit:200}];
        let resp:any=null; for(const body of tries){ try{ resp=await postJSON('/api/data/preview',body); if(resp?.rows) break;}catch{} }
        const rows=Array.isArray(resp?.rows)?resp.rows:[];
        setPreview(rows); setColumns(rows[0]?Object.keys(rows[0]):[]); setPage(1);
      } finally { setBusy(''); }
    })();
  },[datasetId,datasets]);

  // CSV upload
  async function uploadCSV(file:File){
    setBusy('Parsing CSV…');
    const parsed=parseCSV(await file.text()); setPreview(parsed.rows); setColumns(parsed.columns); setPage(1);
    setDatasetId(`local:${file.name}`);
    setBusy('Uploading CSV…'); try{ const fd=new FormData(); fd.append('file',file); await fetch('/api/data/upload',{method:'POST',body:fd}); } finally { setBusy(''); }
  }

  // DB previews
  async function previewDB(provider:string,payload:any){
    setBusy(`Connecting to ${provider}…`);
    try{
      const res=await postJSON('/api/data/db/preview',{provider,...payload,limit:200});
      const rows=Array.isArray(res?.rows)?res.rows:[]; setPreview(rows); setColumns(rows[0]?Object.keys(rows[0]):[]); setDatasetId(`db:${provider}:${payload?.table|| (payload?.query?'query':'')}`); setPage(1);
    } finally { setBusy(''); }
  }

  // recommended NLQ list (simple, using columns)
  const recQ = useMemo(()=>{
    const cols = columns.slice(0,3);
    return [
      cols.length? `How does ${cols[0]} vary by ${cols[1]||'Month'}?` : 'How does Indicator vary by Month?',
      cols.length? `Is ${cols[0]} correlated with ${cols[1]||'Category'}?` : 'Is Indicator correlated with Category_ID?',
      cols.length? `Which combination of ${cols.join(', ')} maximizes outcome?` : 'Which combination of Name, Sex, PassengerId maximizes Survived?'
    ];
  },[columns]);

  return (
    <main className="container">
      {/* top workflow rail */}
      <div style={{display:'flex',alignItems:'center',gap:12,padding:12,flexWrap:'wrap'}}>
        <strong>Workflow:</strong>
        <div className="segtabs">
          {['1. Data','2. EDA','3. Fixes','4. NLQ','5. Model','6. Predict/Explain'].map((t,i)=>
            <span key={t} className={`seg ${activeStep===i+1?'active':''}`}>{t}</span>)}
        </div>
        {busy && <div className="loading" style={{marginLeft:'auto'}}><span className="spinner" /> <span>{busy}</span></div>}
      </div>

      <div className="grid3-root">
        {/* LEFT */}
        <div className="col left-pane" style={{display:'grid',gap:12,alignContent:'start'}}>
          <div className="card"><h2>Explainability</h2><div className="body">
            <ExplainPanel rows={preview} columns={columns}/>
          </div></div>

          <div className="card"><h2>Recommended</h2><div className="body">
            <div className="pill-list">{recQ.map((q,i)=><div key={i} className="pill">{q}</div>)}</div>
          </div></div>

          <div className="card"><h2>Summary</h2><div className="body">
            <ul className="muted" style={{margin:0}}>
              <li>{preview.length} rows • {columns.length} columns</li>
            </ul>
          </div></div>
        </div>

        {/* CENTER */}
        <div className="col center-pane">
          <div className="center-scroll" style={{display:'grid',gap:12}}>
            <div className="card"><h2>2) EDA</h2>
              <div className="body">{ preview.length
                ? <EDACompact rows={preview} columns={columns}/>
                : <div className="muted">Upload/select data to see EDA.</div> }
              </div>
            </div>

            <div className="card"><h2>Preview (15/pg)</h2>
              <div className="body">
                <div className="table-wrap">
                  <table className="table">
                    <thead><tr>{columns.map(c=><th key={c}>{c}</th>)}</tr></thead>
                    <tbody>
                      {pageRows.map((r,ri)=><tr key={ri}>{columns.map(c=><td key={c}>{String(r?.[c]??'')}</td>)}</tr>)}
                    </tbody>
                  </table>
                </div>
                <div style={{display:'flex',justifyContent:'space-between',marginTop:8}}>
                  <div className="muted">Page {page} / {totalPages} · showing {pageRows.length} of {preview.length}</div>
                  <div style={{display:'flex',gap:8}}>
                    <button className="btn" onClick={()=>setPage(p=>Math.max(1,p-1))} disabled={page<=1}>‹ Prev</button>
                    <button className="btn" onClick={()=>setPage(p=>Math.min(totalPages,p+1))} disabled={page>=totalPages}>Next ›</button>
                  </div>
                </div>
              </div>
            </div>

            <div className="statusbar">
              <div>Step {activeStep}: EDA</div>
              <div style={{display:'flex',gap:8}}>
                <button className="btn" onClick={()=>setActiveStep(s=>Math.max(1,s-1))}>Back</button>
                <button className="btn" onClick={()=>setActiveStep(s=>Math.min(6,s+1))}>Next</button>
              </div>
            </div>
          </div>
        </div>

        {/* RIGHT */}
        <div className="col right-pane">
          <div className="card"><h2>Properties</h2>
            <div className="body muted">Dataset: {datasetId || '(none)'} </div>
          </div>

          <div className="card"><h2>Data sources</h2>
            <div className="body" style={{display:'grid',gap:8}}>
              <div className="segtabs">
                {(['DEMO','CSV','POSTGRES','SQLITE','BIGQUERY'] as SourceTab[]).map(t=>
                  <button key={t} className={`seg ${sourceTab===t?'active':''}`} onClick={()=>setSourceTab(t)}>{t}</button>)}
              </div>

              {sourceTab==='DEMO' && (<div style={{display:'grid',gap:6}}>
                <label className="muted">Dataset</label>
                <select value={datasetId} onChange={e=>setDatasetId(e.target.value)}>
                  <option value="" disabled>Select a dataset…</option>
                  {demoOptions.map(o=><option key={o.id} value={o.id}>{o.label}</option>)}
                </select>
              </div>)}

              {sourceTab==='CSV' && (<div style={{display:'grid',gap:6}}>
                <label className="muted">Upload CSV</label>
                <input type="file" accept=".csv" onChange={e=>{const f=e.target.files?.[0]; if(f) uploadCSV(f);}} />
                <div className="muted">We parse locally so EDA shows instantly.</div>
              </div>)}

              {sourceTab==='POSTGRES' && (<div style={{display:'grid',gap:8}}>
                <input className="input" placeholder="postgres://user:pass@host:5432/db" value={pg.url} onChange={e=>setPg({...pg,url:e.target.value})}/>
                <input className="input" placeholder="schema.table (optional)" value={pg.table} onChange={e=>setPg({...pg,table:e.target.value})}/>
                <textarea className="input" placeholder="SELECT * FROM schema.table LIMIT 200 (optional)" value={pg.query} onChange={e=>setPg({...pg,query:e.target.value})}/>
                <button className="btn" onClick={()=>previewDB('postgres',{conn:pg.url,table:pg.table||undefined,query:pg.query||undefined})}>Preview</button>
              </div>)}

              {sourceTab==='SQLITE' && (<div style={{display:'grid',gap:8}}>
                <input className="input" placeholder="/path/to/file.sqlite" value={sq.path} onChange={e=>setSq({...sq,path:e.target.value})}/>
                <input className="input" placeholder="table (optional)" value={sq.table} onChange={e=>setSq({...sq,table:e.target.value})}/>
                <textarea className="input" placeholder="SELECT * FROM table LIMIT 200 (optional)" value={sq.query} onChange={e=>setSq({...sq,query:e.target.value})}/>
                <button className="btn" onClick={()=>previewDB('sqlite',{path:sq.path,table:sq.table||undefined,query:sq.query||undefined})}>Preview</button>
              </div>)}

              {sourceTab==='BIGQUERY' && (<div style={{display:'grid',gap:8}}>
                <input className="input" placeholder="project.dataset.table" value={bq.table} onChange={e=>setBq({...bq,table:e.target.value})}/>
                <textarea className="input" placeholder="SELECT * FROM `project.dataset.table` LIMIT 200 (optional)" value={bq.query} onChange={e=>setBq({...bq,query:e.target.value})}/>
                <button className="btn" onClick={()=>previewDB('bigquery',{table:bq.table||undefined,query:bq.query||undefined})}>Preview</button>
              </div>)}
            </div>
          </div>
        </div>
      </div>
    </main>
  );
}
