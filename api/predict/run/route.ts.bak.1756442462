import { NextResponse } from "next/server";
import { loadDataset, listNumericColumns, pickNumericTarget, coerceNumber } from "@/utils/datasets";
import { llmExplain } from "@/utils/llm";

/** tiny helpers */
function parseBracket(q: string, key: string): string | null {
  const m = new RegExp(String.raw`\\[${key}=([^\\]]+)\\]`, "i").exec(q || "");
  return m ? m[1].trim() : null;
}
function parseHorizon(q: string): number {
  const m = /next\s+(\d+)/i.exec(q || "");
  return m ? Math.max(1, parseInt(m[1], 10)) : 2;
}
function movingAvg(arr: number[], k: number): number[] {
  const out: number[] = [];
  for (let i = 0; i < arr.length; i++) {
    const s = Math.max(0, i - (k - 1));
    const slice = arr.slice(s, i + 1);
    out.push(slice.reduce((a, b) => a + b, 0) / slice.length);
  }
  return out;
}

export async function POST(req: Request) {
  try {
    const body = await req.json().catch(() => ({}));
    const datasetId = String(body?.datasetId ?? "").trim();
    const question: string = String(body?.question ?? body?.q ?? "").trim();

    if (!datasetId) {
      return NextResponse.json({ error: "Missing datasetId" });
    }
    const dsRows = loadDataset(datasetId);
    if (!Array.isArray(dsRows) || dsRows.length === 0) {
      return NextResponse.json({ error: `Dataset "${datasetId}" not found or empty.` });
    }

    // Build numeric series for a target
    const hintedTarget = parseBracket(question, "target") || (typeof body?.target === "string" ? body.target : null);
    let target = pickNumericTarget(dsRows, hintedTarget);
    if (!target) {
      const numeric = listNumericColumns(dsRows);
      return NextResponse.json({
        error: "No numeric target column found.",
        hint: numeric.length ? `Try [target=${numeric[0]}]` : "Upload data with numeric values."
      });
    }

    // Decide task (simple heuristic)
    const forceForecast = !!body?.forceForecast || /forecast|next\s+\d+/i.test(question);
    const task: "forecast" | "regression" = forceForecast ? "forecast" : "regression";

    // Extract y numbers
    const y: number[] = [];
    const idx: (string | number)[] = [];
    for (let i = 0; i < dsRows.length; i++) {
      const v = coerceNumber((dsRows[i] as any)?.[target]);
      if (v !== null) {
        y.push(v);
        idx.push(i); // simple index; UI will still plot in order
      }
    }
    if (y.length < 6) {
      return NextResponse.json({ error: `Not enough numeric values in "${target}" (need >= 6, got ${y.length}).` });
    }

    const horizon = Number.isFinite(body?.horizon) ? Number(body.horizon) : parseHorizon(question);

    // --- modeling (very lightweight) ---
    let series: any[] = [];
    let metrics: any = { rmse: null, mae: null };
    let modelName = "MA-Drift";

    const k = Math.max(3, Math.min(12, Math.floor(y.length / 6)));
    const ma = movingAvg(y, k);

    // drift slope from recent deltas
    let slope = 0;
    const start = Math.max(0, y.length - Math.min(12, y.length - 1));
    const diffs: number[] = [];
    for (let i = start; i < y.length - 1; i++) diffs.push(y[i + 1] - y[i]);
    if (diffs.length) slope = diffs.reduce((a, b) => a + b, 0) / diffs.length;

    // actuals vs fitted (ma)
    for (let i = 0; i < y.length; i++) {
      series.push({ date: String(idx[i]), actual: y[i], forecast: ma[i] ?? y[i] });
    }

    // forecast next h steps
    let last = y[y.length - 1];
    for (let h = 1; h <= horizon; h++) {
      last = last + slope;
      const nextIdx = y.length - 1 + h;
      series.push({ date: String(nextIdx), actual: null, forecast: last });
    }

    // metrics vs MA fit
    const se = y.map((yi, i) => {
      const f = Number.isFinite(ma[i]) ? ma[i] : yi;
      return Math.pow(yi - f, 2);
    });
    const ae = y.map((yi, i) => {
      const f = Number.isFinite(ma[i]) ? ma[i] : yi;
      return Math.abs(yi - f);
    });
    metrics.rmse = Math.sqrt(se.reduce((a, b) => a + b, 0) / y.length);
    metrics.mae = ae.reduce((a, b) => a + b, 0) / y.length;

    const labels = {
      title: (forceForecast ? "Forecast of " : "Model of ") + target,
      target,
      horizon: forceForecast ? horizon : undefined
    };

    const plainExplain =
      `We analyzed **${target}** and produced a ${
        forceForecast ? `forecast for the next ${horizon} periods` : "simple model fit"
      }. The dashed line is the model; overlap with the solid line indicates a close fit. Persistent gaps suggest bias or trend shifts.`;

    let humanSummary = plainExplain;
    try {
      const txt = await llmExplain({
        task,
        target,
        horizon: labels.horizon,
        model: modelName,
        rowsUsed: y.length,
        metrics
      });
      if (txt) humanSummary = txt;
    } catch { /* ignore LLM errors */ }

    return NextResponse.json({
      task,
      labels,
      model: modelName,
      metrics,
      series,
      explain: plainExplain,
      human: { summary: humanSummary }
    });
  } catch (e: any) {
    return NextResponse.json({ error: e?.message ?? "Predict failed" });
  }
}
